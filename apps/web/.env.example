# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=local:local-your-deployment

NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Required server-to-server secret. Configure the identical value in Next.js and Convex.
# Generate a high-entropy value; never prefix it with NEXT_PUBLIC_ or commit the real value.
CONVEX_SERVER_BOUNDARY_KEY=replace-with-a-random-secret

NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet
NEXT_PUBLIC_STELLAR_UI_LABEL=Stellar Testnet
